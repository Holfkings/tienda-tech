# Copiar a .env para desarrollo local. NUNCA commitear .env.
# En Railway estas variables se cargan en el panel: Service > Variables.

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
# Dev local: archivo suelto en el proyecto (3 barras).
DATABASE_URL=sqlite:///./tienda_dev.db
# Prod en Railway: volumen persistente montado en /data (4 barras).
# DATABASE_URL=sqlite:////data/tienda.db

# --- Admin inicial (seed idempotente) ---
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=admin123
# En produccion ADMIN_PASSWORD debe ser distinto de admin123.

# --- Entorno ---
ENVIRONMENT=development
